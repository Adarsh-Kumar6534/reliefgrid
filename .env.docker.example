# ReliefGrid Docker & Kubernetes Environment Template
POSTGRES_USER=reliefuser
POSTGRES_PASSWORD=reliefpassword
POSTGRES_DB=reliefgrid

# Service discovery database & redis URLs inside container network
DATABASE_URL=postgresql://reliefuser:reliefpassword@postgres:5432/reliefgrid
REDIS_URL=redis://redis:6379/0

# API Gateway Prefix & External Public URL
API_PREFIX=/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
