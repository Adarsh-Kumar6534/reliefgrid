{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SECTION A: SYSTEM OVERVIEW & INFRASTRUCTURE HEALTH",
      "type": "row"
    },
    {
      "title": "Platform Operational Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"reliefgrid\", deployment=\"backend\"}) >= 1",
          "legendFormat": "Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CRITICAL / OFFLINE", "color": "red" }, "1": { "text": "HEALTHY / ONLINE", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Backend Replica Count (Current vs Desired)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{namespace=\"reliefgrid\", deployment=\"backend\"}",
          "legendFormat": "Active Backend Replicas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 4, "color": "yellow" },
              { "value": 6, "color": "orange" }
            ]
          }
        }
      }
    },
    {
      "title": "Frontend Replica Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{namespace=\"reliefgrid\", deployment=\"frontend\"}",
          "legendFormat": "Active Frontend Replicas"
        }
      ]
    },
    {
      "title": "Pod Restarts (Past 30m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(changes(kube_pod_container_status_restarts_total{namespace=\"reliefgrid\"}[30m]))",
          "legendFormat": "Restarts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 5, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "SECTION B: APPLICATION TRAFFIC & LATENCY METRICS",
      "type": "row"
    },
    {
      "title": "HTTP Request Rate (Requests / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"reliefgrid\"}[1m]))",
          "legendFormat": "Total Req/sec"
        }
      ]
    },
    {
      "title": "Response Latency (p95 / p90 / p50)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"reliefgrid\"}[1m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\"reliefgrid\"}[1m])) by (le))",
          "legendFormat": "p50 Latency (s)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "SECTION C: KUBERNETES AUTO-SCALING & HPA OBSERVABILITY",
      "type": "row"
    },
    {
      "title": "HPA Replica Scaling (Current vs Desired)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"reliefgrid\", horizontalpodautoscaler=\"backend-hpa\"}",
          "legendFormat": "Current Replicas"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"reliefgrid\", horizontalpodautoscaler=\"backend-hpa\"}",
          "legendFormat": "Desired Replicas"
        }
      ]
    },
    {
      "title": "Backend CPU Utilization vs 60% HPA Target",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"reliefgrid\", pod=~\"backend.*\"}[1m])) / sum(kube_pod_container_resource_requests{namespace=\"reliefgrid\", resource=\"cpu\", pod=~\"backend.*\"}) * 100",
          "legendFormat": "Avg CPU Utilization (%)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "SECTION D: RELIEFGRID CRISIS TELEMETRY OPERATIONS",
      "type": "row"
    },
    {
      "title": "Resource Registry API Traffic",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"reliefgrid\", handler=~\".*resources.*\"}[1m]))",
          "legendFormat": "Resources Req/sec"
        }
      ]
    },
    {
      "title": "Emergency Needs API Traffic",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "id": 10,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"reliefgrid\", handler=~\".*needs.*\"}[1m]))",
          "legendFormat": "Needs Req/sec"
        }
      ]
    },
    {
      "title": "Matching Engine Evaluation Traffic",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"reliefgrid\", handler=~\".*matches.*\"}[1m]))",
          "legendFormat": "Matches Req/sec"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["reliefgrid", "devops", "monitoring"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s"] },
  "timezone": "browser",
  "title": "ReliefGrid — Disaster Operations & Platform Health",
  "version": 1
}
